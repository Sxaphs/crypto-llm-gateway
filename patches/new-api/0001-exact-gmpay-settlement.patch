+func exactEpaySettlementEnabled() bool {
+	return os.Getenv("EPAY_EXACT_QUOTA_ENABLED") == "true" && os.Getenv("EPAY_HMAC_KEY") != ""
+}
+
+func sanitizeEpayParams(params map[string]string) map[string]string {
+	sanitized := make(map[string]string, len(params))
+	for key, value := range params {
+		switch strings.ToLower(key) {
+		case "sign", "signature", "key", "secret", "epay_key":
+			value = "[redacted]"
+		}
+		sanitized[key] = value
+	}
+	return sanitized
+}
+
+// verifyGMPayV2Signature implements the GMPay v2 canonical form: non-empty
+// parameters except signature, ASCII key order, key=value pairs joined by &
+// and lowercase HMAC-SHA256 hex. hmac.Equal performs a constant-time comparison.
+func verifyGMPayV2Signature(params map[string]string, key string) bool {
+	signature := params["signature"]
+	if signature == "" || key == "" {
+		return false
+	}
+	keys := make([]string, 0, len(params))
+	for keyName, value := range params {
+		if keyName != "signature" && value != "" {
+			keys = append(keys, keyName)
+		}
+	}
+	sort.Strings(keys)
+	var canonical strings.Builder
+	for i, keyName := range keys {
+		if i > 0 {
+			canonical.WriteByte('&')
+		}
+		canonical.WriteString(keyName)
+		canonical.WriteByte('=')
+		canonical.WriteString(params[keyName])
+	}
+	mac := hmac.New(sha256.New, []byte(key))
+	_, _ = mac.Write([]byte(canonical.String()))
+	expected := hex.EncodeToString(mac.Sum(nil))
+	return hmac.Equal([]byte(expected), []byte(signature))
+}
+
+func parseGMPayV2Settlement(params map[string]string) (quota int, settledUSD *float64, err error) {
+	if params["pid"] != operation_setting.EpayId || params["out_trade_no"] == "" || params["trade_status"] != epay.StatusTradeSuccess {
+		return 0, nil, errors.New("invalid GMPay merchant, order or trade status")
+	}
+	quotaDecimal, err := decimal.NewFromString(params["credit_quota"])
+	if err != nil || !quotaDecimal.IsInteger() || !quotaDecimal.IsPositive() {
+		return 0, nil, errors.New("credit_quota must be a positive decimal integer")
+	}
+	quota, err = common.WalletQuotaFromDecimalStrict(quotaDecimal)
+	if err != nil || quota <= 0 {
+		return 0, nil, errors.New("credit_quota exceeds the wallet quota range")
+	}
+	if rawSettledUSD := params["settled_usd"]; rawSettledUSD != "" {
+		settledDecimal, parseErr := decimal.NewFromString(rawSettledUSD)
+		if parseErr != nil || settledDecimal.IsNegative() {
+			return 0, nil, errors.New("settled_usd must be a non-negative decimal")
+		}
+		settledValue := settledDecimal.InexactFloat64()
+		if math.IsInf(settledValue, 0) || math.IsNaN(settledValue) {
+			return 0, nil, errors.New("settled_usd exceeds the supported range")
+		}
+		settledUSD = &settledValue
+	}
+	return quota, settledUSD, nil
+}
+
+func rejectEpaySignature(c *gin.Context) {
+	c.Status(http.StatusUnauthorized)
+	_, _ = c.Writer.Write([]byte("fail"))
+}
