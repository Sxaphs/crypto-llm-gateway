new file mode 100644
index 0000000..68c0754
--- /dev/null
+++ b/controller/topup_gmpay_test.go
@@ -0,0 +1,119 @@
+package controller
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/setting/operation_setting"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func validGMPayTestParams() map[string]string {
+	return map[string]string{
+		"pid":                  "merchant-42",
+		"out_trade_no":         "USR7NOabc",
+		"trade_id":             "gmpay-tx-9",
+		"trade_status":         "TRADE_SUCCESS",
+		"type":                 "alipay",
+		"money":                "12.34",
+		"credit_quota":         "6170000",
+		"settled_usd":          "12.34",
+		"actual_amount":        "12.34",
+		"usd_per_token":        "0.000002",
+		"block_transaction_id": "block-9",
+		"empty":                "",
+		"signature":            "0fccce172b27fd19def18f732e96dfbcb53ab65d8c44fa95d87d8095c9196537",
+	}
+}
+
+func TestVerifyGMPayV2Signature(t *testing.T) {
+	params := validGMPayTestParams()
+	assert.True(t, verifyGMPayV2Signature(params, "test-hmac-secret"))
+
+	tampered := validGMPayTestParams()
+	tampered["credit_quota"] = "6170001"
+	assert.False(t, verifyGMPayV2Signature(tampered, "test-hmac-secret"))
+
+	uppercase := validGMPayTestParams()
+	uppercase["signature"] = strings.ToUpper(uppercase["signature"])
+	assert.False(t, verifyGMPayV2Signature(uppercase, "test-hmac-secret"))
+
+	assert.False(t, verifyGMPayV2Signature(params, "wrong-secret"))
+	assert.False(t, verifyGMPayV2Signature(params, ""))
+}
+
+func TestParseGMPayV2Settlement(t *testing.T) {
+	originalEpayID := operation_setting.EpayId
+	operation_setting.EpayId = "merchant-42"
+	t.Cleanup(func() { operation_setting.EpayId = originalEpayID })
+
+	quota, settledUSD, err := parseGMPayV2Settlement(validGMPayTestParams())
+	require.NoError(t, err)
+	assert.Equal(t, 6170000, quota)
+	require.NotNil(t, settledUSD)
+	assert.Equal(t, 12.34, *settledUSD)
+
+	withoutSettledUSD := validGMPayTestParams()
+	delete(withoutSettledUSD, "settled_usd")
+	_, settledUSD, err = parseGMPayV2Settlement(withoutSettledUSD)
+	require.NoError(t, err)
+	assert.Nil(t, settledUSD)
+}
+
+func TestParseGMPayV2SettlementRejectsInvalidFields(t *testing.T) {
+	originalEpayID := operation_setting.EpayId
+	operation_setting.EpayId = "merchant-42"
+	t.Cleanup(func() { operation_setting.EpayId = originalEpayID })
+
+	tests := []struct {
+		name   string
+		mutate func(map[string]string)
+	}{
+		{"wrong pid", func(params map[string]string) { params["pid"] = "other" }},
+		{"missing order", func(params map[string]string) { delete(params, "out_trade_no") }},
+		{"unsuccessful trade", func(params map[string]string) { params["trade_status"] = "WAIT_BUYER_PAY" }},
+		{"missing quota", func(params map[string]string) { delete(params, "credit_quota") }},
+		{"zero quota", func(params map[string]string) { params["credit_quota"] = "0" }},
+		{"negative quota", func(params map[string]string) { params["credit_quota"] = "-1" }},
+		{"fractional quota", func(params map[string]string) { params["credit_quota"] = "1.5" }},
+		{"wallet overflow", func(params map[string]string) { params["credit_quota"] = strconv.Itoa(common.MaxWalletQuota + 1) }},
+		{"negative settled USD", func(params map[string]string) { params["settled_usd"] = "-0.01" }},
+		{"invalid settled USD", func(params map[string]string) { params["settled_usd"] = "not-a-number" }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			params := validGMPayTestParams()
+			tt.mutate(params)
+			_, _, err := parseGMPayV2Settlement(params)
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestRejectEpaySignatureReturns401(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	rejectEpaySignature(c)
+	assert.Equal(t, http.StatusUnauthorized, recorder.Code)
+	assert.Equal(t, "fail", recorder.Body.String())
+}
+
+func TestSanitizeEpayParams(t *testing.T) {
+	sanitized := sanitizeEpayParams(map[string]string{
+		"signature": "full-hmac-signature",
+		"sign":      "full-md5-signature",
+		"key":       "secret-key",
+		"pid":       "merchant-42",
+	})
+	assert.Equal(t, "[redacted]", sanitized["signature"])
+	assert.Equal(t, "[redacted]", sanitized["sign"])
+	assert.Equal(t, "[redacted]", sanitized["key"])
+	assert.Equal(t, "merchant-42", sanitized["pid"])
+}
