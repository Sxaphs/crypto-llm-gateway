+package model
+
+import (
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRechargeEpayExactUsesCallbackQuotaAndIsIdempotent(t *testing.T) {
+	truncateTables(t)
+	user := insertUserForPaymentGuardTest(t, 601, 5)
+	order := createEpayTestOrder(t, user.Id, "EPAYEXACTONCE", PaymentProviderEpay, common.TopUpStatusPending)
+	settledUSD := 8.25
+
+	alreadyDone, err := RechargeEpayExact(order.TradeNo, "wxpay", "127.0.0.1", 1234567, &settledUSD)
+	require.NoError(t, err)
+	assert.False(t, alreadyDone)
+	assert.Equal(t, 1234572, getUserQuotaForPaymentGuardTest(t, user.Id))
+
+	reloaded := GetTopUpByTradeNo(order.TradeNo)
+	require.NotNil(t, reloaded)
+	assert.Equal(t, common.TopUpStatusSuccess, reloaded.Status)
+	assert.Equal(t, 1234567, reloaded.CreditedQuota)
+	assert.Equal(t, 8.25, reloaded.Money)
+	assert.Equal(t, int64(2), reloaded.Amount)
+	assert.Equal(t, "wxpay", reloaded.PaymentMethod)
+
+	alreadyDone, err = RechargeEpayExact(order.TradeNo, "wxpay", "127.0.0.1", 1234567, &settledUSD)
+	require.NoError(t, err)
+	assert.True(t, alreadyDone)
+	assert.Equal(t, 1234572, getUserQuotaForPaymentGuardTest(t, user.Id))
+
+	// A validly signed but inconsistent duplicate must not alter the first credit.
+	otherUSD := 99.0
+	alreadyDone, err = RechargeEpayExact(order.TradeNo, "wxpay", "127.0.0.1", 9999999, &otherUSD)
+	require.NoError(t, err)
+	assert.True(t, alreadyDone)
+	assert.Equal(t, 1234572, getUserQuotaForPaymentGuardTest(t, user.Id))
+	reloaded = GetTopUpByTradeNo(order.TradeNo)
+	assert.Equal(t, 1234567, reloaded.CreditedQuota)
+	assert.Equal(t, 8.25, reloaded.Money)
+}
+
+func TestRechargeEpayExactRejectsInvalidQuota(t *testing.T) {
+	for _, quota := range []int{0, -1, common.MaxWalletQuota + 1} {
+		t.Run("invalid quota", func(t *testing.T) {
+			truncateTables(t)
+			user := insertUserForPaymentGuardTest(t, 602, 7)
+			order := createEpayTestOrder(t, user.Id, "EPAYEXACTINVALID", PaymentProviderEpay, common.TopUpStatusPending)
+
+			alreadyDone, err := RechargeEpayExact(order.TradeNo, "alipay", "127.0.0.1", quota, nil)
+			assert.False(t, alreadyDone)
+			require.ErrorIs(t, err, ErrInvalidTopUpQuota)
+			assert.Equal(t, 7, getUserQuotaForPaymentGuardTest(t, user.Id))
+			assert.Equal(t, common.TopUpStatusPending, getTopUpStatusForPaymentGuardTest(t, order.TradeNo))
+		})
+	}
+}
