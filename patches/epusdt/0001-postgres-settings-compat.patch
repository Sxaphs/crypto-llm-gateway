+func TestValidateNotifyURLAllowsOnlyExactConfiguredInternalURL(t *testing.T) {
+	allowed := "http://payment-adapter:8080/callbacks/gmpay"
+	t.Setenv("EPUSDT_INTERNAL_NOTIFY_URL", allowed)
+	if err := validateNotifyURL(allowed); err != nil {
+		t.Fatalf("exact configured internal URL rejected: %v", err)
+	}
+	for _, denied := range []string{"http://127.0.0.1/notify", allowed + "/other", "http://payment-adapter:8080/"} {
+		if err := validateNotifyURL(denied); err == nil {
+			t.Fatalf("unconfigured internal URL accepted: %s", denied)
+		}
+	}
+}
