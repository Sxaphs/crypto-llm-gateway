# 复制为 .env 后填写。CHANGE_ME 项必须替换；真实 .env 已被 git 忽略。
# 密码不要包含 ${；POSTGRES_PASSWORD 会嵌入 DSN，请使用较长的 URL 安全随机串。

# 核心密钥
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
EPAY_HMAC_KEY=CHANGE_ME
EPAY_MD5_KEY=CHANGE_ME

# epusdt 后台创建 GMPay API Key 后回填。
GMPAY_PID=CHANGE_ME
GMPAY_SECRET_KEY=CHANGE_ME
EPAY_ID=

# 首次启动后取得/修改的管理员密码。
EPUSDT_ADMIN_USERNAME=admin
EPUSDT_ADMIN_PASSWORD=CHANGE_ME
NEW_API_ADMIN_USERNAME=root
NEW_API_ADMIN_PASSWORD=CHANGE_ME

# 管理页面 Basic Auth 用户名固定 admin；这里只存 bcrypt 哈希。
# 生成：docker run --rm caddy:2-alpine caddy hash-password --plaintext '强密码'
# 必须用单引号包住哈希，防止 Compose 把哈希中的 $ 片段当作变量插值。
ADMIN_BASIC_AUTH_HASH='CHANGE_ME'

# 四个 DNS 名称均指向服务器。以下是本机测试默认值。
SITE_DOMAIN=localhost
PAY_DOMAIN=pay.localhost
NEW_API_ADMIN_DOMAIN=newapi.localhost
EPUSDT_ADMIN_DOMAIN=epusdt.localhost
ACME_EMAIL=CHANGE_ME

# 宿主脚本经管理域调用原生管理 API（API 使用 Bearer/JWT，页面使用 Basic Auth）。
NEW_API_BASE_URL=https://newapi.localhost
EPUSDT_BASE_URL=https://epusdt.localhost
# 宿主机验收读取 adapter 审计库；Compose 仅绑定 127.0.0.1，不对公网开放。
ADAPTER_PG_DSN=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/adapter

# New API 初始化。
NEW_API_PRICE_CNY=7.3
NEW_API_MIN_TOPUP=1
# 留空时 New API 使用 ServerAddress=https://SITE_DOMAIN。
NEW_API_CALLBACK_ADDRESS=
NEW_API_SYSTEM_NAME=Crypto LLM
NEW_API_LOGO_TEXT=Crypto LLM

# SMTP；注册必须邮箱验证码。
SMTP_HOST=CHANGE_ME
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME
SMTP_SSL=true
SMTP_FORCE_AUTH_LOGIN=false

# 1–2 个 OpenAI 兼容渠道；第二渠道留空即停用。
OPENAI_CHANNEL_1_NAME=openai
OPENAI_CHANNEL_1_BASE_URL=https://api.openai.com
OPENAI_CHANNEL_1_KEY=CHANGE_ME
OPENAI_CHANNEL_1_MODELS=gpt-4o-mini
OPENAI_CHANNEL_2_NAME=
OPENAI_CHANNEL_2_BASE_URL=
OPENAI_CHANNEL_2_KEY=
OPENAI_CHANNEL_2_MODELS=

# 内置豆包视频渠道（type 54），不自写视频适配层。
ARK_API_KEY=CHANGE_ME
DOUBAO_CHANNEL_NAME=doubao-video
DOUBAO_CHANNEL_BASE_URL=https://ark.cn-beijing.volces.com
DOUBAO_CHANNEL_MODELS=
DOUBAO_CHANNEL_GROUP=default

# 仅配置观察钱包地址，不需要也不应填写私钥/助记词。
TRON_WALLET_ADDRESS=CHANGE_ME
ETH_WALLET_ADDRESS=CHANGE_ME
POLYGON_WALLET_ADDRESS=CHANGE_ME
USDC_POLYGON_CONTRACT=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# 链上查询与告警。
TRONGRID_API_KEY=CHANGE_ME
ETHERSCAN_API_KEY=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# epusdt 后台的自动汇率源；本变量仅作部署记录，实际在后台 settings 配置。
EPUSDT_RATE_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies

# 验收：真实邮箱/IMAP，或使用 --email-code 手工提供验证码。
EMAIL_REGISTER_ADDRESS=CHANGE_ME
EMAIL_REGISTER_USERNAME=CHANGE_ME
EMAIL_REGISTER_PASSWORD=CHANGE_ME
IMAP_HOST=CHANGE_ME
IMAP_PORT=993
IMAP_USERNAME=CHANGE_ME
IMAP_PASSWORD=CHANGE_ME

# 留空令牌时验收脚本会通过用户会话创建 relay token。
ACCEPTANCE_API_TOKEN=
ACCEPTANCE_CHAT_MODEL=gpt-4o-mini
ACCEPTANCE_VIDEO_MODEL=doubao-seedance-1-0-lite-t2v
ACCEPTANCE_USER_ID=
# 充值验收后填写；同次 --all 会自动传递这些值。
EPUSDT_ORDER_TRADE_ID=
EPUSDT_ORDER_OUT_TRADE_NO=
COMPOSE_PROJECT_DIR=.
VIDEO_POLL_TIMEOUT=600

# 镜像固定版本；仅为明确覆盖时才取消注释。
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# EPUSDT_IMAGE=crypto-llm-mvp/epusdt:v2.0.0-pg-fix
# CADDY_IMAGE=caddy:2-alpine
# NEW_API_VERSION=v1.0.0-rc.49
# ADAPTER_IMAGE=crypto-llm-mvp/payment-adapter:local
